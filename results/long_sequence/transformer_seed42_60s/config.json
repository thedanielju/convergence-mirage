{
  "artifact_schema_version": 2,
  "model": "transformer",
  "display_name": "transformer_classifier",
  "seed": 42,
  "entrypoint": "scripts/02_train/train_deep.py",
  "api_contract": {
    "forward": "forward(inputs) -> logits",
    "penultimate": "get_penultimate(inputs) -> representation",
    "intermediate": "get_intermediate_representations(inputs) -> dict[str, Tensor]"
  },
  "training": {
    "batch_size": 32,
    "max_epochs": 50,
    "optimizer": "AdamW",
    "learning_rate": 0.0005,
    "weight_decay": 0.0001,
    "scheduler": "SequentialLR(LinearLR warmup + CosineAnnealingLR)",
    "warmup_epochs": 5,
    "early_stopping_metric": "val_macro_f1",
    "early_stopping_patience": 10,
    "max_grad_norm": 1.0,
    "amp": {
      "enabled_on_cuda": true,
      "enabled_on_cpu": false
    },
    "specaugment": "training_split_only",
    "class_weights": "data/splits/fma_medium/class_weights.json normalized to mean 1.0"
  },
  "debug_gates": {
    "single_batch_overfit_steps": 300,
    "single_batch_size": 8,
    "subset_size": 256,
    "subset_epochs": 8
  },
  "architecture": {
    "input_shape": [
      128,
      1292
    ],
    "d_model": 256,
    "nhead": 4,
    "num_layers": 4,
    "dim_feedforward": 1024,
    "pooling": "cls_token",
    "representation_dim": 256
  },
  "data_loader": {
    "num_workers": 4,
    "seeded_generator": true,
    "worker_init_fn": "seed_worker",
    "crop_seconds": 60.0,
    "data_root": "data/processed/fma_full_60s"
  },
  "crop_seconds": 60.0,
  "data_root": "data/processed/fma_full_60s",
  "data_limits": {
    "limit_train_samples": null,
    "limit_val_samples": null,
    "limit_test_samples": null
  }
}